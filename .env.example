# Copie para .env e ajuste os valores.
# Nunca commite o arquivo .env.

DEBUG=false
CORS_ORIGINS=https://mapa.1nodado.com.br,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Cookie Secure: omitir = Secure quando DEBUG=false; forçar com COOKIE_SECURE=true|false
# COOKIE_SECURE=false

# Atrás de Caddy/Cloudflare: TRUSTED_PROXY=true usa CF-Connecting-IP / X-Forwarded-For
TRUSTED_PROXY=false

# ADMIN_USER / ADMIN_PASSWORD — legado; já NÃO autenticam o Modo GM (spec 095).
# Contas: uv run python -m app.cli usuario criar --email …
# ADMIN_USER=gm
# ADMIN_PASSWORD=change-me

# Backend (dev local) — multi-campanha (specs 093–095)
DATA_DIR=./data
# Limite por ficheiro de upload (default 25 MiB). Independente da cota da campanha (10 GiB).
# MAX_UPLOAD_BYTES=26214400
# CAMPAIGN_SLUG só para seed/scripts locais — HTTP usa /api/c/{slug}/…
# CAMPAIGN_SLUG=minha-campanha

# Frontend: abrir http://localhost:5173/c/<slug> ; login em /login
VITE_API_BASE=
# VITE_MAP_URL legado; o cliente usa /uploads/c/<slug>/map/…

# Motor agnóstico (campos da Campanha na API; .env SISTEMA só legado/scripts)
# SISTEMA=wfrp4e
# MODULOS_ATIVOS=fadiga

# Multi-deploy (spec 078) — preenchido pelo scaffold por instância
# CODEX_INSTANCES_ROOT=/opt
# COMPOSE_PROJECT_NAME=codex-<slug>
# PORTA_API=8020
# PORTA_WEB=8091
# CORS_ORIGINS=https://codex-<slug>.1nodado.com.br
