# Copie para .env e ajuste os valores.
# Nunca commite o arquivo .env.

DEBUG=false
CORS_ORIGINS=https://mapa.1nodado.com.br,http://localhost:5173

# Credenciais do GM (API Basic Auth + gate da UI) — obrigatórias para Modo GM
ADMIN_USER=gm
ADMIN_PASSWORD=change-me
# Se a senha tiver `$`, no Docker Compose escape com `$$` (ex.: senha `a$b` → ADMIN_PASSWORD=a$$b)
# ou use aspas: ADMIN_PASSWORD='a$b'

# Usado pelo Caddy (produção) — hash separado da senha em texto acima
# Gere com: caddy hash-password
ADMIN_PASSWORD_HASH=gm123

# Backend (dev local)
DATABASE_URL=sqlite:///./data/mapa.db
UPLOADS_DIR=./uploads

# Motor agnóstico de sistema (v2 Frente A — spec 077)
# SISTEMA=wfrp4e
# MODULOS_ATIVOS=fadiga          # explícito; omitir = defaults por SISTEMA
# MODULOS_ATIVOS=                 # vazio explícito = nenhum módulo (sobrescreve defaults)
# MIGRATE_DROP_LEGACY_FADIGA=false  # deploy 2: true só após validar migração em produção

# Frontend (build/dev)
VITE_API_BASE=
VITE_MAP_URL=/uploads/map/campaign-map.webp

# Multi-deploy (spec 078) — preenchido pelo scaffold por instância
# CODEX_INSTANCES_ROOT=/opt
# COMPOSE_PROJECT_NAME=codex-<slug>
# PORTA_API=8020
# PORTA_WEB=8091
# CORS_ORIGINS=https://codex-<slug>.1nodado.com.br
