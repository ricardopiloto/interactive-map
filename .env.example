# Copie para .env e ajuste os valores.
# Nunca commite o arquivo .env.

DEBUG=false
CORS_ORIGINS=https://mapa.1nodado.com.br,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Cookie Secure: omitir = Secure quando DEBUG=false; forçar com COOKIE_SECURE=true|false
# COOKIE_SECURE=false

# Atrás de Caddy/Cloudflare: TRUSTED_PROXY=true usa CF-Connecting-IP / X-Forwarded-For
TRUSTED_PROXY=false

# Contas: a primeira conta e os convites criam-se pelo CLI (imprime o link de ativação):
#   uv run python -m app.cli usuario criar --email …
#   uv run python -m app.cli usuario promover-admin --email …

# Backend (dev local) — multi-campanha (specs 093–095)
DATA_DIR=./data
# Limite por ficheiro de upload (default 25 MiB). Independente da cota da campanha (300 MiB).
# MAX_UPLOAD_BYTES=26214400
# CAMPAIGN_SLUG só para seed/scripts locais — HTTP usa /api/c/{slug}/…
# CAMPAIGN_SLUG=minha-campanha

# Frontend: abrir http://localhost:5173/c/<slug> ; login em /login
VITE_API_BASE=

# SISTEMA e MODULOS_ATIVOS só afetam `python -m app.seed` (dev/teste); em produção,
# sistema e módulos são definidos por campanha.
# SISTEMA=wfrp4e
# MODULOS_ATIVOS=fadiga

# IA (DeepSeek). Sem DEEPSEEK_API_KEY a aplicação sobe e a IA fica indisponível.
# A chave é de implantação, não um dado da campanha. Nunca commitar o valor real.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_SECONDS=30

# Multi-deploy (spec 078) — usado pelo docker-compose.yml e pelo override de instância
# COMPOSE_PROJECT_NAME=codex-<slug>
# PORTA_API=8020
# PORTA_WEB=8091
# CORS_ORIGINS=https://codex-<slug>.1nodado.com.br

# Auto-registo: habilitar só depois de configurar e testar o envio
# REGISTO_MODO=fechado
# EMAIL_API_KEY=
# EMAIL_FROM=contas@example.com
# TURNSTILE_SECRET=
# TURNSTILE_SITE_KEY=
# COTA_PADRAO_BYTES=314572800
# REGISTO_DOMINIOS_BLOQUEADOS=./data/dominios-extra.txt
# EMAIL_LOG_FILE=emails.jsonl
# Contato público: configurar TRUSTED_PROXY=true antes de CONTATO_EMAIL em produção
# CONTATO_EMAIL=operador@example.com
# CONTATO_LIMITE_DIARIO=30
# CONTATO_LIMITE_PRIVACIDADE=10
